# Central Postgres superuser. install.sh generates POSTGRES_PASSWORD on first run.
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# GCS backups (set from the panel's Backups page)
GCP_SERVICE_ACCOUNT_CREDENTIALS=
GCS_DB_BACKUP_BUCKET_NAME=
BACKUP_SCHEDULE_HOUR=0,12
BACKUP_SCHEDULE_MINUTE=0
BACKUP_TIMEZONE=Africa/Johannesburg
BACKUP_RETENTION_DAYS=30
BACKUP_ON_STARTUP=false
# Set from the panel; without it no config archive is uploaded.
BACKUP_ARCHIVE_PASSPHRASE=
