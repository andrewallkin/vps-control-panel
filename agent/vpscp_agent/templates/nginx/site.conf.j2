{% for hostname in hostnames %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ hostname.fqdn }};
    return 301 https://{{ http_redirect_target(hostname, primary_fqdn) }}$request_uri;
}

{% endfor %}
{% for hostname in hostnames if hostname.kind != "redirect" %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ hostname.fqdn }};

    ssl_certificate /etc/letsencrypt/live/{{ hostname.domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ hostname.domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
{% if panel %}
    add_header X-Robots-Tag noindex always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
{% endif %}

{% for route in routes %}
    location {{ route.path if route.path != "/" else "/" }} {
        proxy_pass http://127.0.0.1:{{ route.port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size {{ route.max_body_mb }}m;
        proxy_read_timeout {{ route.read_timeout_s }}s;
        proxy_send_timeout {{ route.send_timeout_s }}s;
{% if route.pass_authorization %}
        proxy_set_header Authorization $http_authorization;
{% endif %}
{% if route.streaming %}
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
{% endif %}
{% if route.websocket %}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
    }

{% endfor %}
}

{% endfor %}
{% for hostname in hostnames if hostname.kind == "redirect" %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ hostname.fqdn }};

    ssl_certificate /etc/letsencrypt/live/{{ hostname.domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ hostname.domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://{{ primary_fqdn }}$request_uri;
}

{% endfor %}
